# Pins for the learning cluster. Bump these on purpose; the docs follow this file.
export OPENSHELL_CHART_VERSION=0.1.9
export OPENSHELL_CLI_VERSION=v0.1.9

# Cilium stable kind guide currently publishes 1.20.x. NetworkPolicy enforcement
# is the reason this cluster does not use kindnet.
export CILIUM_VERSION=1.20.5

# Leave empty to use the Kubernetes version shipped with the local kind binary.
# Set a full image ref such as kindest/node:v1.32.2 to pin it. OpenShell wants
# Kubernetes 1.29 or newer.
export KIND_NODE_IMAGE=

export LOCAL_PATH_VERSION=v0.0.32
export AGENT_SANDBOX_MANIFEST=https://github.com/kubernetes-sigs/agent-sandbox/releases/latest/download/sandbox.yaml

export CLUSTER_NAME=openshell
export NAMESPACE=openshell
export GATEWAY_NAME=kind
export GATEWAY_PORT=18080

# Kind loads this name into containerd. Override with a registry ref before
# pushing the same image to a datacenter cluster.
export SAMPLE_IMAGE="${SAMPLE_IMAGE:-docker.io/library/openshell-sample-agent:0.1.0}"
export SAMPLE_SANDBOX_NAME=sample-agent
